{
  "compilerOptions": {
    "module": "commonjs",
    "types": ["node", "jest"],
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@/test/*": ["test/*"],
      "@/commonDecorators/*": ["src/common/decorators/*"],
      "@/commonPipes/*": ["src/common/pipes/*"],
      "@/commonGuards/*": ["src/common/guards/*"],
      "@/common/*": ["src/common/*"],
      "@/shared/*": ["src/shared/*"],
      "@/baseInterface/*": ["src/base/interface/*"],
      "@/baseDto/*": ["src/base/dto/*"],
      "@/base/*": ["src/base/*"],
      "@/baseServices/*": ["src/base/service/*"],
      "@/middleware/*": ["src/middleware/*"],
      "@/interceptors/*": ["src/interceptors/*"],
      "@/utils/*": ["src/utils/*"],
      "@/lib/*": ["src/lib/*"],
      "@/libConst/*": ["src/lib/const/*"],
      "@/config/*": ["src/config/*"],
      "@/userEntities/*": ["src/user/entities/*"],
      "@/userHelper/*": ["src/user/helper/*"],
      "@/userService/*": ["src/user/services/*"],
      "@/userRoleService/*": ["src/user/services/roles/*"],
      "@/userDepartmentService/*": ["src/user/services/departments/*"],
      "@/userQueryDto/*": ["src/user/dto/query/*"],
      "@/userDto/*": ["src/user/dto/*"],
      "@/user/*": ["src/user/*"],
      "@/seed/*": ["src/seed/*"],
      "@/permissionServices/*": ["src/role/permission/services/*"],
      "@/permissionDto/*": ["src/role/permission/dto/*"],
      "@/permissionEntities/*": ["src/role/permission/entities/*"],
      "@/permission/*": ["src/role/permission/*"],
      "@/roleDto/*": ["src/role/dto/*"],
      "@/roleHelper/*": ["src/role/helper/*"],
      "@/roleServices/*": ["src/role/services/*"],
      "@/roleEntities/*": ["src/role/entities/*"],
      "@/role/*": ["src/role/*"],
      "@/authHelper/*": ["src/auth/helper/*"],
      "@/authInterfaces/*": ["src/auth/interfaces/*"],
      "@/authDto/*": ["src/auth/dto/*"],
      "@/auth/*": ["src/auth/*"],
      "@/departmentDto/*": ["src/department/dto/*"],
      "@/departmentServices/*": ["src/department/services/*"],
      "@/departmentHelper/*": ["src/department/helper/*"],
      "@/departmentEntities/*": ["src/department/entities/*"],
      "@/department/*": ["src/department/*"],
      "@/storeDto/*": ["src/store/dto/*"],
      "@/storeServices/*": ["src/store/services/*"],
      "@/storeHelper/*": ["src/store/helper/*"],
      "@/storeEntities/*": ["src/store/entities/*"],
      "@/store/*": ["src/store/*"],
      "@/src/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "*.config.ts",
    "jest.setup.ts",
    "../.tmp/user/user-deprecated.controller.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
