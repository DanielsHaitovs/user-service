{
  "compilerOptions": {
    "module": "commonjs",
    "types": ["node", "jest"],
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true,
    "strict": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@/test/*": ["test/*"],
      "@/commonDecorators/*": ["src/common/decorators/*"],
      "@/commonPipes/*": ["src/common/pipes/*"],
      "@/commonGuards/*": ["src/common/guards/*"],
      "@/common/*": ["src/common/*"],
      "@/modules/*": ["src/modules/*"],
      "@/shared/*": ["src/shared/*"],
      "@/baseInterface/*": ["src/modules/base/interface/*"],
      "@/baseDto/*": ["src/modules/base/dto/*"],
      "@/base/*": ["src/modules/base/*"],
      "@/baseServices/*": ["src/modules/base/service/*"],
      "@/middleware/*": ["src/middleware/*"],
      "@/interceptors/*": ["src/interceptors/*"],
      "@/utils/*": ["src/utils/*"],
      "@/lib/*": ["src/lib/*"],
      "@/config/*": ["src/config/*"],
      "@/userEntities/*": ["src/modules/user/entities/*"],
      "@/userHelper/*": ["src/modules/user/helper/*"],
      "@/userService/*": ["src/modules/user/services/*"],
      "@/userRoleService/*": ["src/modules/user/services/roles/*"],
      "@/userDepartmentService/*": ["src/modules/user/services/departments/*"],
      "@/userQueryDto/*": ["src/modules/user/dto/query/*"],
      "@/userDto/*": ["src/modules/user/dto/*"],
      "@/userConst/*": ["src/modules/user/const/*"],
      "@/userEnum/*": ["src/modules/user/enum/*"],
      "@/user/*": ["src/modules/user/*"],
      "@/seed/*": ["src/modules/seed/*"],
      "@/rolePermissionDto/*": ["src/modules/role/dto/permission/*"],
      "@/roleDto/*": ["src/modules/role/dto/role/*"],
      "@/roleConst/*": ["src/modules/role/const/*"],
      "@/roleHelper/*": ["src/modules/role/helper/*"],
      "@/roleServices/*": ["src/modules/role/services/role/*"],
      "@/rolePermissionServices/*": ["src/modules/role/services/permission/*"],
      "@/roleEntities/*": ["src/modules/role/entities/*"],
      "@/role/*": ["src/modules/role/*"],
      "@/authHelper/*": ["src/auth/helper/*"],
      "@/authInterfaces/*": ["src/auth/interfaces/*"],
      "@/authDto/*": ["src/auth/dto/*"],
      "@/auth/*": ["src/auth/*"],
      "@/departmentDto/*": ["src/modules/department/dto/*"],
      "@/departmentConst/*": ["src/modules/department/const/*"],
      "@/departmentServices/*": ["src/modules/department/services/*"],
      "@/departmentHelper/*": ["src/modules/department/helper/*"],
      "@/departmentEntities/*": ["src/modules/department/entities/*"],
      "@/department/*": ["src/modules/department/*"]
    }
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "*.config.ts",
    "jest.setup.ts",
    "../.tmp/user/user-deprecated.controller.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
